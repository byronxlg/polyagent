# PolyAgent Environment Variables
# Copy this file to .env and fill in your values

# Database connection (used by backend and worker)
DATABASE_URL=postgresql://agent:agent@localhost:5432/polyagent

# LLM API Keys (at least one required for agents to function)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
